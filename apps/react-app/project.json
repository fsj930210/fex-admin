{
  "name": "react-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/react-app/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "command": "vite --host 127.0.0.1 --port 4001 --strictPort",
      "options": { "cwd": "apps/react-app" }
    },
    "build": {
      "command": "vite build",
      "options": { "cwd": "apps/react-app" },
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": { "command": "tsc --noEmit -p apps/react-app/tsconfig.json" },
    "lint": {
      "command": "oxlint apps/react-app/src apps/react-app/vite.config.ts"
    }
  }
}

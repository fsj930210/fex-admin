{
  "name": "fex-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev --all --parallel=6",
    "dev:docs": "pnpm --dir apps/docs dev",
    "dev:server": "pnpm --dir server start:dev",
    "build:server": "pnpm --dir server build",
    "start:server": "pnpm --dir server start:prod",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "nx run-many -t lint,typecheck,build",
    "dev:react": "nx dev react-admin",
    "dev:vue": "nx dev vue-admin",
    "dev:solid": "nx dev solid-admin",
    "dev:svelte": "nx dev svelte-admin",
    "dev:angular": "nx dev angular-admin"
  },
  "devDependencies": {
    "@angular/compiler-cli": "22.1.0",
    "@fex/config-oxc": "workspace:*",
    "@fex/config-tsconfig": "workspace:*",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.1",
    "nx": "23.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "svelte-check": "latest",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "latest"
  },
  "packageManager": "pnpm@11.19.0"
}
